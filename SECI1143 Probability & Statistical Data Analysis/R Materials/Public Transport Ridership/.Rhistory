ridership_data <- read.csv("ridership_headline.csv", header=TRUE)
lrt_ampang <- na.omit(ridership_data$rail_lrt_ampang)
mrt_kajang <- na.omit(ridership_data$rail_mrt_kajang)
var.test(lrt_ampang, mrt_kajang)
t.test(lrt_ampang, mrt_kajang, alternative = "two.sided", var.equal = FALSE)
var.test(lrt_ampang, mrt_kajang)
View(ridership_data)
savehistory("~/SECPH UTM/SECI1143 Probability & Statistical Data Analysis/1. R Materials/Public Transport Ridership/Hypothesis Testing Two-Sample.Rhistory")
